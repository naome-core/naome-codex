{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "naome-codex",
  "version": "0.1.2",
  "description": "Record research from an enrolled Codex workspace in a local NAOME lab.",
  "author": {
    "name": "NAOME"
  },
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "NAOME Research Lab",
        "shortDescription": "Record lab research",
        "longDescription": "Capture research in a local NAOME lab archive and report assigned evidence to an orchestrator.",
        "developerName": "NAOME",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ]
      },
      "requires_local_executor": true
    }
  },
  "license": "MIT"
}
